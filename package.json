{
 "name": "ictl",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "overrides": {
  "protobufjs": "7.5.9",
  "rollup": "4.63.5",
  "lodash": "4.18.1"
 },
 "scripts": {
  "typecheck": "tsc --noEmit",
  "dev:server": "tsx watch server/index.ts",
  "db:generate": "drizzle-kit generate",
  "db:migrate": "tsx server/db/migrate.ts",
  "dev": "concurrently -n web,api -c blue,green \"vite\" \"npm run dev:server\"",
  "build": "vite build",
  "build:dev": "vite build --mode development",
  "lint": "eslint .",
  "docs:lint": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\"",
  "docs:links": "node scripts/check-doc-links.mjs",
  "docs:check": "npm run docs:lint && npm run docs:links",
  "preview": "vite preview",
  "test": "vitest run",
  "test:watch": "vitest"
 },
 "dependencies": {
  "@better-auth/cli": "^1.4.22",
  "@hookform/resolvers": "^3.10.0",
  "@mantine/core": "^7.17.8",
  "@mantine/dates": "^7.17.8",
  "@mantine/form": "^7.17.8",
  "@mantine/hooks": "^7.17.8",
  "@mantine/notifications": "^7.17.8",
  "@tabler/icons-react": "^3.50.0",
  "@tanstack/react-query": "^5.83.0",
  "better-auth": "^1.7.15",
  "cors": "^2.8.6",
  "date-fns": "^3.6.0",
  "dayjs": "^1.11.23",
  "dotenv": "18.0.9",
  "drizzle-orm": "^0.45.4",
  "exceljs": "^4.4.0",
  "express": "^5.3.0",
  "html5-qrcode": "^2.3.8",
  "lucide-react": "^1.66.0",
  "postgres": "^4.0.0",
  "qrcode.react": "^4.2.0",
  "react": "^18.3.1",
  "react-day-picker": "^8.10.1",
  "react-dom": "^18.3.1",
  "react-hook-form": "^7.61.1",
  "react-router-dom": "^6.30.1",
  "recharts": "^2.15.4",
  "zod": "^3.25.76"
 },
 "devDependencies": {
  "@eslint/js": "^9.17.0",
  "@testing-library/jest-dom": "^7.0.1",
  "@testing-library/react": "^16.3.3",
  "@types/cors": "^2.8.19",
  "@types/express": "^5.0.6",
  "@types/node": "^22.10.2",
  "@types/react": "^18.3.18",
  "@types/react-dom": "^18.3.5",
  "@vitejs/plugin-react": "^4.3.4",
  "@vitejs/plugin-react-swc": "^3.7.0",
  "concurrently": "^9.1.2",
  "drizzle-kit": "^0.31.11",
  "eslint": "^9.17.0",
  "eslint-plugin-react-hooks": "^5.1.0",
  "eslint-plugin-react-refresh": "^0.4.16",
  "globals": "^15.14.0",
  "jsdom": "^30.1.3",
  "playwright": "^1.64.1",
  "tsx": "^4.19.2",
  "typescript": "~5.6.2",
  "typescript-eslint": "^8.18.2",
  "vite": "^6.0.5",
  "vite-plugin-node-polyfills": "^0.28.0",
  "vitest": "^2.1.8"
 }
}
